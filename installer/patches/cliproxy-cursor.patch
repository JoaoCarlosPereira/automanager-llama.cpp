diff --git a/internal/cmd/cursor_login.go b/internal/cmd/cursor_login.go
new file mode 100644
index 0000000..c4481e5
--- /dev/null
+++ b/internal/cmd/cursor_login.go
@@ -0,0 +1,35 @@
+package cmd
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	sdkAuth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// DoCursorLogin runs the Cursor agent CLI login and stores the credential marker.
+func DoCursorLogin(cfg *config.Config, options *LoginOptions) {
+	if options == nil {
+		options = &LoginOptions{}
+	}
+	manager := newAuthManager()
+	record, savedPath, err := manager.Login(context.Background(), "cursor", cfg, &sdkAuth.LoginOptions{
+		NoBrowser:    options.NoBrowser,
+		CallbackPort: options.CallbackPort,
+		Metadata:     map[string]string{},
+		Prompt:       options.Prompt,
+	})
+	if err != nil {
+		log.Errorf("Cursor authentication failed: %v", err)
+		return
+	}
+	if savedPath != "" {
+		fmt.Printf("Authentication saved to %s\n", savedPath)
+	}
+	if record != nil && record.Label != "" {
+		fmt.Printf("Authenticated as %s\n", record.Label)
+	}
+	fmt.Println("Cursor authentication successful!")
+}
diff --git a/internal/cursorcli/cli.go b/internal/cursorcli/cli.go
new file mode 100644
index 0000000..ad0fa27
--- /dev/null
+++ b/internal/cursorcli/cli.go
@@ -0,0 +1,471 @@
+// Package cursorcli runs the official Cursor agent CLI.
+package cursorcli
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+)
+
+const defaultCompleteTimeout = 15 * time.Minute
+
+var emailPattern = regexp.MustCompile(`[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}`)
+
+// Account is the signed-in Cursor CLI identity.
+type Account struct {
+	Email    string
+	Label    string
+	LoggedIn bool
+}
+
+// Model is one model id reported by the CLI.
+type Model struct {
+	ID          string
+	DisplayName string
+}
+
+// ResolveBinary finds the agent executable.
+func ResolveBinary() (string, error) {
+	for _, name := range []string{"agent", "cursor-agent"} {
+		if path, err := exec.LookPath(name); err == nil && path != "" {
+			return path, nil
+		}
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return "", fmt.Errorf("cursor cli: agent executable not found")
+	}
+	for _, name := range []string{"agent", "cursor-agent"} {
+		candidate := filepath.Join(home, ".local", "bin", name)
+		info, errStat := os.Stat(candidate)
+		if errStat == nil && !info.IsDir() && info.Mode()&0o111 != 0 {
+			return candidate, nil
+		}
+	}
+	return "", fmt.Errorf("cursor cli: agent executable not found")
+}
+
+// Status reads the current CLI login.
+func Status(ctx context.Context) (Account, error) {
+	binary, err := ResolveBinary()
+	if err != nil {
+		return Account{}, err
+	}
+	stdout, errRun := run(ctx, binary, nil, "", 30*time.Second, "status", "--format", "json")
+	if errRun != nil {
+		stdout, errRun = run(ctx, binary, nil, "", 30*time.Second, "whoami", "--format", "json")
+	}
+	if strings.TrimSpace(stdout) == "" && errRun != nil {
+		return Account{}, errRun
+	}
+	return ParseStatus(stdout), nil
+}
+
+// Login starts the CLI login flow. Credentials stay in the CLI's own store.
+func Login(ctx context.Context, noBrowser bool) error {
+	binary, err := ResolveBinary()
+	if err != nil {
+		return err
+	}
+	env := os.Environ()
+	if noBrowser {
+		env = append(env, "NO_OPEN_BROWSER=1")
+	}
+	cmd := exec.CommandContext(ctx, binary, "login")
+	cmd.Env = env
+	cmd.Stdin = os.Stdin
+	cmd.Stdout = os.Stdout
+	cmd.Stderr = os.Stderr
+	if errRun := cmd.Run(); errRun != nil {
+		return fmt.Errorf("cursor cli: login failed: %w", errRun)
+	}
+	return nil
+}
+
+// ListModels returns the models available to the signed-in account.
+func ListModels(ctx context.Context) ([]Model, error) {
+	binary, err := ResolveBinary()
+	if err != nil {
+		return nil, err
+	}
+	stdout, errRun := run(ctx, binary, nil, "", 30*time.Second, "models", "--format", "json")
+	models := ParseModels(stdout)
+	if len(models) > 0 {
+		return models, nil
+	}
+	stdout, errRun = run(ctx, binary, nil, "", 30*time.Second, "--list-models")
+	models = ParseModels(stdout)
+	if len(models) == 0 && errRun != nil {
+		return nil, errRun
+	}
+	return models, nil
+}
+
+// Complete runs one read-only agent turn in an empty workspace.
+func Complete(ctx context.Context, model, prompt, apiKey string) (string, error) {
+	binary, err := ResolveBinary()
+	if err != nil {
+		return "", err
+	}
+	model = strings.TrimSpace(model)
+	prompt = strings.TrimSpace(prompt)
+	if model == "" {
+		return "", fmt.Errorf("cursor cli: model is required")
+	}
+	if prompt == "" {
+		return "", fmt.Errorf("cursor cli: prompt is required")
+	}
+	workspace, errDir := os.MkdirTemp("", "cursor-ask-")
+	if errDir != nil {
+		return "", errDir
+	}
+	defer os.RemoveAll(workspace)
+
+	env := os.Environ()
+	if key := strings.TrimSpace(apiKey); key != "" {
+		env = append(env, "CURSOR_API_KEY="+key)
+	}
+	args := []string{
+		"-p",
+		"--mode", "ask",
+		"--model", model,
+		"--output-format", "json",
+		"--trust",
+	}
+	stdout, errRun := run(ctx, binary, env, workspace, defaultCompleteTimeout, append(args, prompt)...)
+	if errRun != nil && isUnknownFlag(errRun, stdout) {
+		stdout, errRun = run(ctx, binary, env, workspace, defaultCompleteTimeout, "-p", "--mode", "ask", "--model", model, "--output-format", "json", prompt)
+	}
+	text := ExtractResult(stdout)
+	if text == "" && errRun != nil {
+		return "", errRun
+	}
+	if text == "" {
+		return "", fmt.Errorf("cursor cli: empty response")
+	}
+	return text, nil
+}
+
+func run(ctx context.Context, binary string, env []string, dir string, timeout time.Duration, args ...string) (string, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if _, hasDeadline := ctx.Deadline(); !hasDeadline && timeout > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, timeout)
+		defer cancel()
+	}
+	cmd := exec.CommandContext(ctx, binary, args...)
+	if len(env) > 0 {
+		cmd.Env = env
+	}
+	if dir != "" {
+		cmd.Dir = dir
+	}
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	combined := stdout.String()
+	if err != nil {
+		message := strings.TrimSpace(stderr.String())
+		if message == "" {
+			message = strings.TrimSpace(combined)
+		}
+		if message == "" {
+			message = err.Error()
+		}
+		return combined, fmt.Errorf("cursor cli: %s", message)
+	}
+	return combined, nil
+}
+
+func isUnknownFlag(err error, stdout string) bool {
+	text := strings.ToLower(err.Error() + "\n" + stdout)
+	return strings.Contains(text, "unknown flag") || strings.Contains(text, "flag provided but not defined")
+}
+
+// ParseStatus reads agent status output.
+func ParseStatus(raw string) Account {
+	raw = strings.TrimSpace(raw)
+	account := Account{}
+	if raw == "" {
+		return account
+	}
+	var payload any
+	if err := json.Unmarshal([]byte(raw), &payload); err == nil {
+		account = accountFromJSON(payload)
+	}
+	if account.Email == "" {
+		if found := emailPattern.FindString(raw); found != "" {
+			account.Email = found
+		}
+	}
+	lower := strings.ToLower(raw)
+	if strings.Contains(lower, "logged in") || strings.Contains(lower, "logged_in") || strings.Contains(lower, "\"authenticated\":true") || strings.Contains(lower, "\"authenticated\": true") {
+		account.LoggedIn = true
+	}
+	if account.Email != "" && !strings.Contains(lower, "not logged") && !strings.Contains(lower, "logged out") {
+		account.LoggedIn = true
+	}
+	if account.Label == "" {
+		account.Label = account.Email
+	}
+	return account
+}
+
+func accountFromJSON(payload any) Account {
+	account := Account{}
+	switch value := payload.(type) {
+	case map[string]any:
+		account.Email = firstString(value, "email", "userEmail", "user_email")
+		account.Label = firstString(value, "label", "name", "user", "username", "account")
+		if logged, ok := value["loggedIn"].(bool); ok {
+			account.LoggedIn = logged
+		}
+		if logged, ok := value["logged_in"].(bool); ok {
+			account.LoggedIn = logged
+		}
+		if logged, ok := value["authenticated"].(bool); ok {
+			account.LoggedIn = logged
+		}
+		if status := strings.ToLower(firstString(value, "status", "state")); status != "" {
+			if strings.Contains(status, "login") || status == "ok" || status == "ready" || status == "authenticated" {
+				account.LoggedIn = true
+			}
+		}
+		for _, key := range []string{"account", "user", "profile"} {
+			if nested, ok := value[key].(map[string]any); ok {
+				nestedAccount := accountFromJSON(nested)
+				if account.Email == "" {
+					account.Email = nestedAccount.Email
+				}
+				if account.Label == "" {
+					account.Label = nestedAccount.Label
+				}
+				account.LoggedIn = account.LoggedIn || nestedAccount.LoggedIn
+			}
+		}
+	}
+	return account
+}
+
+// ParseModels reads agent models output.
+func ParseModels(raw string) []Model {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return nil
+	}
+	if models := modelsFromJSON(raw); len(models) > 0 {
+		return models
+	}
+	var models []Model
+	seen := map[string]struct{}{}
+	for _, line := range strings.Split(raw, "\n") {
+		id, display := modelFromLine(line)
+		if id == "" {
+			continue
+		}
+		if _, ok := seen[id]; ok {
+			continue
+		}
+		seen[id] = struct{}{}
+		models = append(models, Model{ID: id, DisplayName: display})
+	}
+	return models
+}
+
+func modelsFromJSON(raw string) []Model {
+	var payload any
+	if err := json.Unmarshal([]byte(raw), &payload); err != nil {
+		var collected []Model
+		seen := map[string]struct{}{}
+		for _, line := range strings.Split(raw, "\n") {
+			line = strings.TrimSpace(line)
+			if line == "" || (line[0] != '{' && line[0] != '[') {
+				continue
+			}
+			for _, model := range modelsFromJSON(line) {
+				if _, ok := seen[model.ID]; ok {
+					continue
+				}
+				seen[model.ID] = struct{}{}
+				collected = append(collected, model)
+			}
+		}
+		return collected
+	}
+	return modelsFromValue(payload)
+}
+
+func modelsFromValue(payload any) []Model {
+	switch value := payload.(type) {
+	case []any:
+		var models []Model
+		for _, item := range value {
+			models = append(models, modelsFromValue(item)...)
+		}
+		return models
+	case map[string]any:
+		if id := firstString(value, "id", "model", "name", "slug"); id != "" && !isWrapperKey(id) {
+			display := firstString(value, "displayName", "display_name", "label", "title")
+			if display == "" {
+				display = id
+			}
+			return []Model{{ID: id, DisplayName: display}}
+		}
+		for _, key := range []string{"models", "data", "items", "results"} {
+			if nested, ok := value[key]; ok {
+				if models := modelsFromValue(nested); len(models) > 0 {
+					return models
+				}
+			}
+		}
+	case string:
+		id := strings.TrimSpace(value)
+		if id == "" || strings.Contains(id, " ") {
+			return nil
+		}
+		return []Model{{ID: id, DisplayName: id}}
+	}
+	return nil
+}
+
+func isWrapperKey(id string) bool {
+	switch strings.ToLower(id) {
+	case "models", "data", "items", "results":
+		return true
+	default:
+		return false
+	}
+}
+
+func modelFromLine(line string) (string, string) {
+	line = strings.TrimSpace(line)
+	line = strings.TrimLeft(line, "-*• \t")
+	if line == "" || strings.HasPrefix(strings.ToLower(line), "available") || strings.HasPrefix(strings.ToLower(line), "model") && strings.Contains(strings.ToLower(line), " ") && !strings.Contains(line, "/") {
+		if strings.HasSuffix(strings.ToLower(line), ":") {
+			return "", ""
+		}
+	}
+	fields := strings.Fields(line)
+	if len(fields) == 0 {
+		return "", ""
+	}
+	id := strings.Trim(fields[0], "`:,")
+	if id == "" || strings.EqualFold(id, "model") || strings.EqualFold(id, "models") || strings.EqualFold(id, "id") {
+		return "", ""
+	}
+	if strings.Contains(id, " ") {
+		return "", ""
+	}
+	display := id
+	if len(fields) > 1 {
+		rest := strings.TrimSpace(strings.TrimLeft(strings.Join(fields[1:], " "), "-–—:"))
+		if rest != "" {
+			display = rest
+		}
+	}
+	return id, display
+}
+
+// ExtractResult reads the assistant text from print-mode output.
+func ExtractResult(raw string) string {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return ""
+	}
+	var last string
+	for _, line := range strings.Split(raw, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || (line[0] != '{' && line[0] != '[') {
+			continue
+		}
+		if text := resultFromJSON(line); text != "" {
+			last = text
+		}
+	}
+	if last != "" {
+		return last
+	}
+	if text := resultFromJSON(raw); text != "" {
+		return text
+	}
+	return raw
+}
+
+func resultFromJSON(raw string) string {
+	var payload any
+	if err := json.Unmarshal([]byte(raw), &payload); err != nil {
+		return ""
+	}
+	return resultFromValue(payload)
+}
+
+func resultFromValue(payload any) string {
+	switch value := payload.(type) {
+	case map[string]any:
+		if text := firstString(value, "result", "text", "message", "response", "content"); text != "" {
+			return text
+		}
+		for _, key := range []string{"message", "data", "output"} {
+			if nested, ok := value[key]; ok {
+				if text := resultFromValue(nested); text != "" {
+					return text
+				}
+			}
+		}
+	case []any:
+		var last string
+		for _, item := range value {
+			if text := resultFromValue(item); text != "" {
+				last = text
+			}
+		}
+		return last
+	case string:
+		return strings.TrimSpace(value)
+	}
+	return ""
+}
+
+func firstString(values map[string]any, keys ...string) string {
+	for _, key := range keys {
+		raw, ok := values[key]
+		if !ok || raw == nil {
+			continue
+		}
+		switch typed := raw.(type) {
+		case string:
+			if text := strings.TrimSpace(typed); text != "" {
+				return text
+			}
+		}
+	}
+	return ""
+}
+
+// APIKeyFromAuth reads a dashboard API key stored on the credential.
+func APIKeyFromAuth(metadata map[string]any, attributes map[string]string) string {
+	if attributes != nil {
+		if key := strings.TrimSpace(attributes["api_key"]); key != "" {
+			return key
+		}
+	}
+	if metadata == nil {
+		return ""
+	}
+	for _, key := range []string{"api_key", "apiKey", "cursor_api_key"} {
+		if raw, ok := metadata[key].(string); ok && strings.TrimSpace(raw) != "" {
+			return strings.TrimSpace(raw)
+		}
+	}
+	return ""
+}
diff --git a/internal/cursorcli/cli_test.go b/internal/cursorcli/cli_test.go
