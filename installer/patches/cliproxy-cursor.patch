@@ -0,0 +1,99 @@
+package auth
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/cursorcli"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// CursorAuthenticator records a Cursor CLI login in the shared auth directory.
+type CursorAuthenticator struct{}
+
+// NewCursorAuthenticator constructs a Cursor authenticator.
+func NewCursorAuthenticator() Authenticator { return &CursorAuthenticator{} }
+
+// Provider returns the provider key.
+func (CursorAuthenticator) Provider() string { return "cursor" }
+
+// RefreshLead reports that the CLI owns credential refresh.
+func (CursorAuthenticator) RefreshLead() *time.Duration { return nil }
+
+// Login runs agent login when needed and persists a cursor-*.json credential.
+func (CursorAuthenticator) Login(ctx context.Context, cfg *config.Config, opts *LoginOptions) (*coreauth.Auth, error) {
+	if cfg == nil {
+		return nil, fmt.Errorf("cliproxy auth: configuration is required")
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if opts == nil {
+		opts = &LoginOptions{}
+	}
+	account, errStatus := cursorcli.Status(ctx)
+	if errStatus != nil || !account.LoggedIn {
+		if errLogin := cursorcli.Login(ctx, opts.NoBrowser); errLogin != nil {
+			return nil, errLogin
+		}
+		account, errStatus = cursorcli.Status(ctx)
+		if errStatus != nil {
+			return nil, errStatus
+		}
+	}
+	if !account.LoggedIn {
+		return nil, fmt.Errorf("cursor: CLI login did not produce an authenticated account")
+	}
+	label := strings.TrimSpace(account.Label)
+	if label == "" {
+		label = strings.TrimSpace(account.Email)
+	}
+	if label == "" {
+		label = "cursor"
+	}
+	fileID := cursorFileID(account.Email)
+	fileName := "cursor-" + fileID + ".json"
+	metadata := map[string]any{
+		"type":      "cursor",
+		"email":     account.Email,
+		"label":     label,
+		"auth_kind": "oauth",
+	}
+	return &coreauth.Auth{
+		ID:       fileName,
+		Provider: "cursor",
+		FileName: fileName,
+		Label:    label,
+		Status:   coreauth.StatusActive,
+		Attributes: map[string]string{
+			"email":     account.Email,
+			"auth_kind": "oauth",
+		},
+		Metadata: metadata,
+		CreatedAt: time.Now().UTC(),
+		UpdatedAt: time.Now().UTC(),
+	}, nil
+}
+
+func cursorFileID(email string) string {
+	email = strings.TrimSpace(email)
+	if email == "" {
+		return "default"
+	}
+	var b strings.Builder
+	for _, r := range email {
+		switch {
+		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9', r == '-', r == '_', r == '.', r == '@':
+			b.WriteRune(r)
+		default:
+			b.WriteByte('_')
+		}
+	}
+	if b.Len() == 0 {
+		return "default"
+	}
+	return b.String()
+}
