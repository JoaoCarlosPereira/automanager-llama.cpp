+++ b/internal/cursorcli/cli_test.go
@@ -0,0 +1,37 @@
+package cursorcli
+
+import "testing"
+
+func TestParseStatusJSON(t *testing.T) {
+	account := ParseStatus(`{"authenticated":true,"email":"dev@example.com","label":"Dev"}`)
+	if !account.LoggedIn {
+		t.Fatal("expected logged in")
+	}
+	if account.Email != "dev@example.com" {
+		t.Fatalf("email = %q", account.Email)
+	}
+	if account.Label != "Dev" {
+		t.Fatalf("label = %q", account.Label)
+	}
+}
+
+func TestParseModelsTextAndJSON(t *testing.T) {
+	fromJSON := ParseModels(`{"models":[{"id":"gpt-5.5","displayName":"GPT-5.5"},{"id":"composer-2"}]}`)
+	if len(fromJSON) != 2 || fromJSON[0].ID != "gpt-5.5" || fromJSON[1].DisplayName != "composer-2" {
+		t.Fatalf("json models = %#v", fromJSON)
+	}
+	fromText := ParseModels("Available models:\n- gpt-5.5 GPT-5.5\ncomposer-2\n")
+	if len(fromText) != 2 || fromText[0].ID != "gpt-5.5" || fromText[0].DisplayName != "GPT-5.5" {
+		t.Fatalf("text models = %#v", fromText)
+	}
+}
+
+func TestExtractResult(t *testing.T) {
+	raw := "{\"type\":\"result\",\"result\":\"hello cursor\"}\n"
+	if got := ExtractResult(raw); got != "hello cursor" {
+		t.Fatalf("result = %q", got)
+	}
+	if got := ExtractResult("plain text"); got != "plain text" {
+		t.Fatalf("plain = %q", got)
+	}
+}
diff --git a/internal/registry/cursor_models.go b/internal/registry/cursor_models.go
new file mode 100644
index 0000000..5dfb2d0
--- /dev/null
+++ b/internal/registry/cursor_models.go
@@ -0,0 +1,57 @@
+package registry
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/cursorcli"
+	log "github.com/sirupsen/logrus"
+)
+
+var cursorModelCache = struct {
+	sync.Mutex
+	at     time.Time
+	models []*ModelInfo
+}{}
+
+// GetCursorModels returns the account catalog reported by the Cursor agent CLI.
+func GetCursorModels() []*ModelInfo {
+	cursorModelCache.Lock()
+	defer cursorModelCache.Unlock()
+	if cursorModelCache.models != nil && time.Since(cursorModelCache.at) < 30*time.Second {
+		return cloneModelInfos(cursorModelCache.models)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	listed, err := cursorcli.ListModels(ctx)
+	if err != nil {
+		log.Warnf("cursor models: %v", err)
+		if cursorModelCache.models != nil {
+			return cloneModelInfos(cursorModelCache.models)
+		}
+		return nil
+	}
+	models := make([]*ModelInfo, 0, len(listed))
+	for _, model := range listed {
+		if model.ID == "" {
+			continue
+		}
+		display := model.DisplayName
+		if display == "" {
+			display = model.ID
+		}
+		models = append(models, &ModelInfo{
+			ID:          model.ID,
+			Object:      "model",
+			OwnedBy:     "cursor",
+			Type:        "cursor",
+			DisplayName: display,
+			Name:        model.ID,
+			Description: display,
+		})
+	}
+	cursorModelCache.at = time.Now()
+	cursorModelCache.models = models
+	return cloneModelInfos(models)
+}
diff --git a/internal/runtime/executor/cursor_executor.go b/internal/runtime/executor/cursor_executor.go
new file mode 100644
index 0000000..1bd26e2
--- /dev/null
+++ b/internal/runtime/executor/cursor_executor.go
@@ -0,0 +1,263 @@
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/cursorcli"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+var _ cliproxyauth.ProviderExecutor = (*CursorExecutor)(nil)
+
+// CursorExecutor proxies OpenAI chat requests through the Cursor agent CLI.
+type CursorExecutor struct {
+	cfg *config.Config
+}
+
+// NewCursorExecutor constructs a Cursor executor.
+func NewCursorExecutor(cfg *config.Config) *CursorExecutor {
+	return &CursorExecutor{cfg: cfg}
+}
+
+// Identifier returns the provider key.
+func (e *CursorExecutor) Identifier() string { return "cursor" }
+
+// Execute runs one read-only agent turn and returns an OpenAI chat completion.
+func (e *CursorExecutor) Execute(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	var resp cliproxyexecutor.Response
+	text, model, translated, err := e.complete(ctx, auth, req, opts)
+	if err != nil {
+		return resp, err
+	}
+	responseFormat := cliproxyexecutor.ResponseFormatOrSource(opts)
+	body := openAIChatCompletion(model, text)
+	var param any
+	out := sdktranslator.TranslateNonStream(
+		ctx,
+		sdktranslator.FormatOpenAI,
+		responseFormat,
+		req.Model,
+		opts.OriginalRequest,
+		translated,
+		body,
+		&param,
+	)
+	if len(out) == 0 {
+		out = body
+	}
+	resp.Payload = out
+	return resp, nil
+}
+
+// ExecuteStream returns the same final answer as a single OpenAI stream.
+func (e *CursorExecutor) ExecuteStream(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	text, model, translated, err := e.complete(ctx, auth, req, opts)
+	if err != nil {
+		return nil, err
+	}
+	responseFormat := cliproxyexecutor.ResponseFormatOrSource(opts)
+	frames := [][]byte{
+		openAIStreamFrame(model, text, ""),
+		openAIStreamFrame(model, "", "stop"),
+		[]byte("data: [DONE]\n\n"),
+	}
+	out := make(chan cliproxyexecutor.StreamChunk, len(frames))
+	var param any
+	go func() {
+		defer close(out)
+		for _, frame := range frames {
+			chunks := sdktranslator.TranslateStream(
+				ctx,
+				sdktranslator.FormatOpenAI,
+				responseFormat,
+				req.Model,
+				opts.OriginalRequest,
+				translated,
+				frame,
+				&param,
+			)
+			if len(chunks) == 0 {
+				chunks = [][]byte{frame}
+			}
+			for _, chunk := range chunks {
+				select {
+				case out <- cliproxyexecutor.StreamChunk{Payload: chunk}:
+				case <-ctx.Done():
+					return
+				}
+			}
+		}
+	}()
+	return &cliproxyexecutor.StreamResult{Chunks: out}, nil
+}
+
+// Refresh keeps the CLI-managed credential unchanged.
+func (e *CursorExecutor) Refresh(_ context.Context, auth *cliproxyauth.Auth) (*cliproxyauth.Auth, error) {
+	return auth, nil
+}
+
+// CountTokens estimates the translated prompt length.
+func (e *CursorExecutor) CountTokens(ctx context.Context, _ *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	translated := translateToOpenAI(req, opts, false)
+	prompt := promptFromOpenAI(translated)
+	count := int64(len(prompt) / 4)
+	if count < 1 && prompt != "" {
+		count = 1
+	}
+	payload := sdktranslator.TranslateTokenCount(ctx, sdktranslator.FormatOpenAI, cliproxyexecutor.ResponseFormatOrSource(opts), count, translated)
+	return cliproxyexecutor.Response{Payload: payload}, nil
+}
+
+// HttpRequest is unused. Cursor traffic goes through the agent CLI.
+func (e *CursorExecutor) HttpRequest(context.Context, *cliproxyauth.Auth, *http.Request) (*http.Response, error) {
+	return nil, fmt.Errorf("cursor executor: raw HTTP is not supported")
+}
+
+func (e *CursorExecutor) complete(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (string, string, []byte, error) {
+	translated := translateToOpenAI(req, opts, opts.Stream)
+	model := strings.TrimSpace(req.Model)
+	if model == "" {
+		model = strings.TrimSpace(gjson.GetBytes(translated, "model").String())
+	}
+	prompt := promptFromOpenAI(translated)
+	if strings.TrimSpace(prompt) == "" {
+		return "", model, translated, statusErr{code: http.StatusBadRequest, msg: "cursor executor: empty prompt"}
+	}
+	var metadata map[string]any
+	var attributes map[string]string
+	if auth != nil {
+		metadata = auth.Metadata
+		attributes = auth.Attributes
+	}
+	text, err := cursorcli.Complete(ctx, model, prompt, cursorcli.APIKeyFromAuth(metadata, attributes))
+	if err != nil {
+		return "", model, translated, statusErr{code: http.StatusBadGateway, msg: err.Error()}
+	}
+	return text, model, translated, nil
+}
+
+func translateToOpenAI(req cliproxyexecutor.Request, opts cliproxyexecutor.Options, stream bool) []byte {
+	from := opts.SourceFormat
+	if from == "" {
+		from = sdktranslator.FormatOpenAI
+	}
+	source := req.Payload
+	if len(opts.OriginalRequest) > 0 {
+		source = opts.OriginalRequest
+	}
+	translated := sdktranslator.TranslateRequest(from, sdktranslator.FormatOpenAI, req.Model, source, stream)
+	if len(translated) == 0 {
+		return source
+	}
+	return translated
+}
+
+func promptFromOpenAI(payload []byte) string {
+	messages := gjson.GetBytes(payload, "messages")
+	if !messages.Exists() {
+		if prompt := strings.TrimSpace(gjson.GetBytes(payload, "prompt").String()); prompt != "" {
+			return prompt
+		}
+		if input := strings.TrimSpace(gjson.GetBytes(payload, "input").String()); input != "" {
+			return input
+		}
+		return strings.TrimSpace(string(payload))
+	}
+	var parts []string
+	messages.ForEach(func(_, message gjson.Result) bool {
+		role := strings.TrimSpace(message.Get("role").String())
+		if role == "" {
+			role = "user"
+		}
+		content := messageContent(message.Get("content"))
+		if content == "" {
+			return true
+		}
+		parts = append(parts, role+": "+content)
+		return true
+	})
+	return strings.TrimSpace(strings.Join(parts, "\n\n"))
+}
+
+func messageContent(content gjson.Result) string {
+	if !content.Exists() {
+		return ""
+	}
+	if content.Type == gjson.String {
+		return strings.TrimSpace(content.String())
+	}
+	var parts []string
+	content.ForEach(func(_, part gjson.Result) bool {
+		text := strings.TrimSpace(part.Get("text").String())
+		if text == "" && part.Type == gjson.String {
+			text = strings.TrimSpace(part.String())
+		}
+		if text != "" {
+			parts = append(parts, text)
+		}
+		return true
+	})
+	return strings.TrimSpace(strings.Join(parts, "\n"))
+}
+
+func openAIChatCompletion(model, text string) []byte {
+	payload := map[string]any{
+		"id":      "chatcmpl-cursor",
+		"object":  "chat.completion",
+		"created": time.Now().Unix(),
+		"model":   model,
+		"choices": []any{
+			map[string]any{
+				"index": 0,
+				"message": map[string]any{
+					"role":    "assistant",
+					"content": text,
+				},
+				"finish_reason": "stop",
+			},
+		},
+	}
+	encoded, err := json.Marshal(payload)
+	if err != nil {
+		return []byte(`{"error":"cursor executor: failed to encode response"}`)
+	}
+	return encoded
+}
+
+func openAIStreamFrame(model, text, finish string) []byte {
+	delta := map[string]any{}
+	if text != "" {
+		delta["role"] = "assistant"
+		delta["content"] = text
+	}
+	choice := map[string]any{
+		"index": 0,
+		"delta": delta,
+	}
+	if finish != "" {
+		choice["finish_reason"] = finish
+	} else {
+		choice["finish_reason"] = nil
+	}
+	payload := map[string]any{
+		"id":      "chatcmpl-cursor",
+		"object":  "chat.completion.chunk",
+		"created": time.Now().Unix(),
+		"model":   model,
+		"choices": []any{choice},
+	}
+	encoded, err := json.Marshal(payload)
+	if err != nil {
+		encoded = []byte(`{}`)
+	}
+	return append(append([]byte("data: "), encoded...), []byte("\n\n")...)
+}
